# ---------------------------------------------------------------------------
# Game content never enters this repo. You bring your own APK.
# ---------------------------------------------------------------------------
*.apk
*.aab
*.dex
*.so
*.rgb
*.bsv3
*.xml.bin
assets/
dlc/
gameassets/
sprites/
extracted/
work/

# Lifter output is derived from the game binary -- also never committed.
recompiled/
generated/

# Save games / personal data
towns/
saves/
*.pb
.env

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
build/
cmake-build-*/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe
*.pdb

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.vs/
.vscode/
.idea/
*.sln
*.vcxproj*
.DS_Store

# tool output. Anchored to the root: unanchored, "triage.md" also matches
# docs/TRIAGE.md on a case-insensitive filesystem, which is a documented file
# silently missing from the repository.
/probe.txt
/run.txt
/triage.md

verify.txt

# lifted program and its build
build-lifted/
fnverify.txt
obj_test/
generated_test/

# Boot and build logs: our own output, but full of the game binary's
# addresses and banners, and occasionally enormous.
boot.out
boot.err
*.log

# Local launchers. They hardcode one machine's paths and one title's, and this
# repository is deliberately game-agnostic.
build-lifted.bat
run-*.bat

# Every run redirects a pair of these, and a frame capture writes one of those.
*.out
*.err
*.ppm
